<Window x:Class="TicTacToe.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TicTacToe"
        mc:Ignorable="d"
        Title="Tic Tac Toe" Height="543" Width="800">
    <Canvas Margin="12,0,-12,0">
        <Button Content="" HorizontalAlignment="Center" VerticalAlignment="Top" Height="128" Width="123" Canvas.Left="10" Canvas.Top="389"/>
        <Button Content="" HorizontalAlignment="Center" VerticalAlignment="Top" Height="128" Width="123" Canvas.Left="140" Canvas.Top="389"/>
        <Button Content="" HorizontalAlignment="Center" VerticalAlignment="Top" Height="128" Width="123" Canvas.Left="270" Canvas.Top="389"/>
        <Button Content="" HorizontalAlignment="Center" VerticalAlignment="Top" Height="128" Width="123" Canvas.Left="10" Canvas.Top="256"/>
        <Button Content="" HorizontalAlignment="Center" VerticalAlignment="Top" Height="128" Width="123" Canvas.Left="140" Canvas.Top="256"/>
        <Button Content="" HorizontalAlignment="Center" VerticalAlignment="Top" Height="128" Width="123" Canvas.Left="270" Canvas.Top="256"/>
        <Button Content="" HorizontalAlignment="Center" VerticalAlignment="Top" Height="128" Width="123" Canvas.Left="10" Canvas.Top="123"/>
        <Button Content="" HorizontalAlignment="Center" VerticalAlignment="Top" Height="128" Width="123" Canvas.Left="140" Canvas.Top="123"/>
        <Button Content="" HorizontalAlignment="Center" VerticalAlignment="Top" Height="128" Width="123" Canvas.Left="270" Canvas.Top="123"/>
        <Label Content="X Player" Canvas.Left="10" Canvas.Top="40" HorizontalAlignment="Left" VerticalAlignment="Center"/>
        <TextBox Canvas.Left="67" TextWrapping="Wrap" Text="" Canvas.Top="44" Width="120" HorizontalAlignment="Center" VerticalAlignment="Center" TextChanged="TextBox_TextChanged"/>
        <Label Content="O Player" Canvas.Left="216" Canvas.Top="40" HorizontalAlignment="Left" VerticalAlignment="Center"/>
        <TextBox Canvas.Left="273" TextWrapping="Wrap" Text="" Canvas.Top="44" Width="120" TextChanged="TextBox_TextChanged" HorizontalAlignment="Left" VerticalAlignment="Center"/>
        <Button Content="Choose Starting Player" Canvas.Left="10" Canvas.Top="67" HorizontalAlignment="Left" Height="45" VerticalAlignment="Center"/>
        <Label Content="Current Player" Canvas.Left="159" Canvas.Top="66" HorizontalAlignment="Center" VerticalAlignment="Top" RenderTransformOrigin="0.549,-0.037"/>
        <TextBox Canvas.Left="182" TextWrapping="Wrap" Canvas.Top="92" Width="38" HorizontalAlignment="Left" VerticalAlignment="Center" Height="22" IsReadOnly="True"/>
        <Label Content="Score" Canvas.Left="415" Canvas.Top="123" FontSize="24" HorizontalAlignment="Left" VerticalAlignment="Center"/>
        <Label Content="X" Canvas.Left="415" Canvas.Top="187" RenderTransformOrigin="0.59,0.537" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <TextBox Canvas.Left="437" TextWrapping="Wrap" Canvas.Top="191" Width="33" HorizontalAlignment="Left" VerticalAlignment="Center"/>
        <Label Content="O" Canvas.Left="415" Canvas.Top="214" RenderTransformOrigin="0.59,0.537" HorizontalAlignment="Center" VerticalAlignment="Top"/>
        <TextBox Canvas.Left="437" TextWrapping="Wrap" Canvas.Top="218" Width="33" HorizontalAlignment="Center" VerticalAlignment="Top"/>
        <Label Content="Current Round" Canvas.Left="415" Canvas.Top="241" RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Center" VerticalAlignment="Top"/>
        <TextBox Canvas.Left="437" TextWrapping="Wrap" Canvas.Top="267" Width="33" HorizontalAlignment="Center" VerticalAlignment="Top"/>
    </Canvas>
</Window>
